<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Soal dari Bumona untuk Megy - Day 5</title>
  <style>
    :root {
      --bg: #f8fafc;
      --card: #ffffff;
      --text: #1e293b;
      --primary: #059669;
      --primary-hover: #047857;
      --success: #10b981;
      --danger: #ef4444;
      --border: #e2e8f0;
    }
    body {
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
      background-color: var(--bg);
      color: var(--text);
      line-height: 1.6;
      margin: 0;
      padding: 16px;
    }
    .container {
      max-width: 680px;
      margin: 0 auto;
    }
    .header {
      background: linear-gradient(135deg, #059669, #10b981);
      color: white;
      padding: 24px;
      border-radius: 16px;
      margin-bottom: 24px;
      text-align: center;
      box-shadow: 0 10px 15px -3px rgba(5, 150, 105, 0.25);
    }
    .header h1 {
      margin: 0 0 8px 0;
      font-size: 1.5rem;
    }
    .header p {
      margin: 0;
      opacity: 0.95;
      font-size: 0.95rem;
    }
    .card {
      background: var(--card);
      border-radius: 16px;
      padding: 20px;
      margin-bottom: 20px;
      border: 1px solid var(--border);
      box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05);
    }
    .badge {
      display: inline-block;
      background: #d1fae5;
      color: #065f46;
      font-size: 0.75rem;
      font-weight: 700;
      padding: 4px 10px;
      border-radius: 20px;
      margin-bottom: 12px;
      text-transform: uppercase;
    }
    .question-title {
      font-weight: 600;
      font-size: 1.05rem;
      margin-bottom: 16px;
    }
    .options {
      display: flex;
      flex-direction: column;
      gap: 10px;
    }
    .option-btn {
      background: #f8fafc;
      border: 1.5px solid var(--border);
      border-radius: 10px;
      padding: 12px 16px;
      text-align: left;
      font-size: 0.95rem;
      cursor: pointer;
      transition: all 0.2s ease;
      color: var(--text);
    }
    .option-btn:hover {
      border-color: var(--primary);
      background: #f0fdf4;
    }
    .option-btn.correct {
      background-color: #d1fae5 !important;
      border-color: var(--success) !important;
      color: #065f46 !important;
      font-weight: 600;
    }
    .option-btn.wrong {
      background-color: #fee2e2 !important;
      border-color: var(--danger) !important;
      color: #991b1b !important;
    }
    .explanation {
      display: none;
      margin-top: 16px;
      padding: 14px;
      border-radius: 10px;
      background: #f0fdf4;
      border-left: 4px solid var(--primary);
      font-size: 0.9rem;
    }
    .hint-btn {
      background: none;
      border: none;
      color: var(--primary);
      font-size: 0.85rem;
      cursor: pointer;
      padding: 0;
      margin-top: 10px;
      text-decoration: underline;
    }
    .hint-text {
      display: none;
      font-size: 0.85rem;
      color: #64748b;
      margin-top: 6px;
      font-style: italic;
    }
    .result-card {
      display: none;
      text-align: center;
      padding: 30px;
    }
    .score-number {
      font-size: 3rem;
      font-weight: 800;
      color: var(--primary);
      margin: 10px 0;
    }
    .next-nav-btn {
      display: inline-block;
      margin-top: 20px;
      background: var(--primary);
      color: white;
      padding: 12px 24px;
      border-radius: 10px;
      text-decoration: none;
      font-weight: 600;
      font-size: 0.95rem;
      transition: background 0.2s ease;
    }
    .next-nav-btn:hover {
      background: var(--primary-hover);
    }
  </style>
</head>
<body>

<div class="container">
  <div class="header">
    <h1>Soal dari Bumona untuk Megy</h1>
    <p>Day 5 - TKA SMA Spesialis UTBK (Ekonomi, Sosiologi, Geografi, Sejarah & Matkul)</p>
  </div>

  <!-- Soal 1 -->
  <div class="card" id="q1">
    <span class="badge">TKA EKONOMI • KEBIJAKAN MONETER</span>
    <div class="question-title">1. Saat perekonomian negara mengalami tingkat inflasi yang tinggi, Bank Indonesia menjalankan kebijakan moneter kontraktif (tight money policy). Kebijakan yang tepat dilakukan oleh Bank Indonesia adalah...</div>
    <div class="options">
      <button class="option-btn" onclick="checkAnswer(1, 'A')">A. Menurunkan tingkat suku bunga acuan (BI Rate).</button>
      <button class="option-btn" onclick="checkAnswer(1, 'B')">B. Membeli surat-surat berharga milik pemerintah dari masyarakat.</button>
      <button class="option-btn" onclick="checkAnswer(1, 'C')">C. Menurunkan persentase cadangan kas minimum di bank umum.</button>
      <button class="option-btn" onclick="checkAnswer(1, 'D')">D. Menjual Sertifikat Bank Indonesia (SBI) kepada masyarakat.</button>
      <button class="option-btn" onclick="checkAnswer(1, 'E')">E. Mempermudah dan memperluas syarat pemberian kredit perbankan.</button>
    </div>
    <button class="hint-btn" onclick="toggleHint(1)">💡 Butuh Petunjuk?</button>
    <div class="hint-text" id="hint1">Kebijakan kontraktif bertujuan menyedot jumlah uang beredar dari masyarakat agar inflasi mereda.</div>
    <div class="explanation" id="exp1">
      <strong>Jawaban Benar: D</strong><br>
      <em>Pembahasan:</em><br>
      Untuk menekan inflasi, Bank Indonesia harus mengurangi jumlah uang beredar di masyarakat. Caranya adalah dengan **menjual surat berharga (SBI)** melalui Operasi Pasar Terbuka, sehingga uang dari masyarakat/bank mengalir masuk ke Bank Indonesia.
    </div>
  </div>

  <!-- Soal 2 -->
  <div class="card" id="q2">
    <span class="badge">TKA SOSIOLOGI • STRATIFIKASI & MOBILITAS</span>
    <div class="question-title">2. Seorang anak dari keluarga petani miskin di pedesaan berhasil menyelesaikan pendidikan sarjana dan kini menjabat sebagai direktur utama di sebuah perusahaan multinasional. Bentuk mobilitas sosial yang dialami oleh anak tersebut adalah...</div>
    <div class="options">
      <button class="option-btn" onclick="checkAnswer(2, 'A')">A. Mobilitas sosial vertikal naik antargenerasi</button>
      <button class="option-btn" onclick="checkAnswer(2, 'B')">B. Mobilitas sosial vertikal naik intragenerasi</button>
      <button class="option-btn" onclick="checkAnswer(2, 'C')">C. Mobilitas sosial horizontal antargenerasi</button>
      <button class="option-btn" onclick="checkAnswer(2, 'D')">D. Mobilitas sosial lateral intragenerasi</button>
      <button class="option-btn" onclick="checkAnswer(2, 'E')">E. Mobilitas sosial geografis berulang</button>
    </div>
    <button class="hint-btn" onclick="toggleHint(2)">💡 Butuh Petunjuk?</button>
    <div class="hint-text" id="hint2">Bandingkan status anak dengan status orang tuanya (berbeda generasi) dan perhatikan arah perubahan statusnya (naik/turun).</div>
    <div class="explanation" id="exp2">
      <strong>Jawaban Benar: A</strong><br>
      <em>Pembahasan:</em><br>
      • **Vertikal Naik:** Perubahan kedudukan sosial ke tingkat yang lebih tinggi (dari buruh/petani menjadi direktur).<br>
      • **Antargenerasi:** Terjadi perubahan status sosial antara dua generasi (orang tua petani vs anak direktur).
    </div>
  </div>

  <!-- Soal 3 -->
  <div class="card" id="q3">
    <span class="badge">TKA GEOGRAFI • PEDOSFER & VULKANISME</span>
    <div class="question-title">3. Daerah di sekitar lereng gunung api aktif umumnya memiliki tingkat kesuburan tanah yang sangat tinggi untuk pertanian, meskipun sering terdampak erupsi. Jenis tanah subur yang terbentuk dari hasil pelapukan abu vulkanik tersebut adalah...</div>
    <div class="options">
      <button class="option-btn" onclick="checkAnswer(3, 'A')">A. Tanah Organosol / Gambut</button>
      <button class="option-btn" onclick="checkAnswer(3, 'B')">B. Tanah Andosol</button>
      <button class="option-btn" onclick="checkAnswer(3, 'C')">C. Tanah Grumosol</button>
      <button class="option-btn" onclick="checkAnswer(3, 'D')">D. Tanah Latosol</button>
      <button class="option-btn" onclick="checkAnswer(3, 'E')">E. Tanah Regosol Pasir</button>
    </div>
    <button class="hint-btn" onclick="toggleHint(3)">💡 Butuh Petunjuk?</button>
    <div class="hint-text" id="hint3">Tanah ini khas daerah gunung berapi, kaya unsur hara, dan berwarna gelap kecokelatan.</div>
    <div class="explanation" id="exp3">
      <strong>Jawaban Benar: B</strong><br>
      <em>Pembahasan:</em><br>
      **Tanah Andosol** adalah jenis tanah vulkanik yang berasal dari pelapukan material vulkanik seperti abu dan tefra gunung api. Tanah ini sangat subur dan kaya bahan organik, sangat cocok untuk pertanian sayur dan perkebunan.
    </div>
  </div>

  <!-- Soal 4 -->
  <div class="card" id="q4">
    <span class="badge">TKA SEJARAH • PERGERAKAN NASIONAL</span>
    <div class="question-title">4. Organisasi pergerakan nasional seperti Perhimpunan Indonesia (PI) dan Partai Nasional Indonesia (PNI) memilih strategi **nonkooperatif** terhadap pemerintah kolonial Belanda. Alasan utama penerapan strategi nonkooperatif tersebut adalah...</div>
    <div class="options">
      <button class="option-btn" onclick="checkAnswer(4, 'A')">A. Keinginan untuk mendapatkan bantuan dana dari pemerintah kolonial Belanda.</button>
      <button class="option-btn" onclick="checkAnswer(4, 'B')">B. Keyakinan bahwa kemerdekaan Indonesia harus diraih atas kekuatan bangsa sendiri.</button>
      <button class="option-btn" onclick="checkAnswer(4, 'C')">C. Adanya larangan dari Belanda untuk mendirikan partai politik swasta.</button>
      <button class="option-btn" onclick="checkAnswer(4, 'D')">D. Keinginan menduduki posisi penting dalam dewan Volksraad buatan Belanda.</button>
      <button class="option-btn" onclick="checkAnswer(4, 'E')">E. Menunggu instruksi resmi dari badan perdamaian Liga Bangsa-Bangsa.</button>
    </div>
    <button class="hint-btn" onclick="toggleHint(4)">💡 Butuh Petunjuk?</button>
    <div class="hint-text" id="hint4">Prinsip nonkooperatif meyakini konsep "self-help" (berdiri di atas kaki sendiri/berdikari).</div>
    <div class="explanation" id="exp4">
      <strong>Jawaban Benar: B</strong><br>
      <em>Pembahasan:</em><br>
      Strategi **nonkooperatif** menolak bekerja sama dengan kolonial Belanda (termasuk menolak duduk di Volksraad). Landasannya adalah prinsip *self-help*, yaitu keyakinan bahwa Indonesia hanya bisa merdeka jika berjuang mandiri menggunakan kekuatan bangsa kita sendiri.
    </div>
  </div>

  <!-- Soal 5 -->
  <div class="card" id="q5">
    <span class="badge">TKA MATEMATIKA • BARISAN & DERET</span>
    <div class="question-title">5. Diketahui suku ke-3 suatu barisan aritmetika adalah 11 dan suku ke-7 adalah 23. Berapakah jumlah 10 suku pertama (S10) dari barisan aritmetika tersebut?</div>
    <div class="options">
      <button class="option-btn" onclick="checkAnswer(5, 'A')">A. 140</button>
      <button class="option-btn" onclick="checkAnswer(5, 'B')">B. 165</button>
      <button class="option-btn" onclick="checkAnswer(5, 'C')">C. 185</button>
      <button class="option-btn" onclick="checkAnswer(5, 'D')">D. 210</button>
      <button class="option-btn" onclick="checkAnswer(5, 'E')">E. 235</button>
    </div>
    <button class="hint-btn" onclick="toggleHint(5)">💡 Butuh Petunjuk?</button>
    <div class="hint-text" id="hint5">Cari beda (b) dulu dari selisih U7 - U3 = 4b. Cari suku awal (a), lalu gunakan Sn = (n/2) × (2a + (n-1)b).</div>
    <div class="explanation" id="exp5">
      <strong>Jawaban Benar: C</strong><br>
      <em>Pembahasan:</em><br>
      • U7 - U3 = (a + 6b) - (a + 2b) ➔ 23 - 11 = 4b ➔ 12 = 4b ➔ **b = 3**<br>
      • Subtitusi b: a + 2(3) = 11 ➔ a + 6 = 11 ➔ **a = 5**<br>
      • Rumus S10 = (10 / 2) × (2(5) + (10 - 1)3)<br>
      • S10 = 5 × (10 + 9 × 3) = 5 × (10 + 27) = 5 × 37 = **185**.
    </div>
  </div>

  <!-- Ringkasan Hasil -->
  <div class="card result-card" id="resultCard">
    <h2>🎉 Kuis Day 5 Selesai!</h2>
    <p>Hasil Kuis Day 5 Megy:</p>
    <div class="score-number" id="scoreText">0 / 5</div>
    <p id="evalText" style="color: #475569; font-weight: 500;"></p>

    <!-- Navigasi Otomatis ke Day 6 -->
    <a href="day6.html" class="next-nav-btn">Lanjut ke Day 6 ➔</a>
  </div>
</div>

<script>
  const correctAnswers = { 1: 'D', 2: 'A', 3: 'B', 4: 'B', 5: 'C' };
  let userAnswers = {};
  let answeredCount = 0;

  function checkAnswer(qNum, selectedOption) {
    if (userAnswers[qNum]) return;

    userAnswers[qNum] = selectedOption;
    answeredCount++;

    const options = document.querySelectorAll(`#q${qNum} .option-btn`);
    const correctOpt = correctAnswers[qNum];

    options.forEach(btn => {
      btn.disabled = true;
      const optLetter = btn.innerText.charAt(0);
      if (optLetter === correctOpt) {
        btn.classList.add('correct');
      }
      if (optLetter === selectedOption && selectedOption !== correctOpt) {
        btn.classList.add('wrong');
      }
    });

    document.getElementById(`exp${qNum}`).style.display = 'block';

    if (answeredCount === 5) {
      showResults();
    }
  }

  function toggleHint(qNum) {
    const hint = document.getElementById(`hint${qNum}`);
    hint.style.display = hint.style.display === 'block' ? 'none' : 'block';
  }

  function showResults() {
    let score = 0;
    for (let i = 1; i <= 5; i++) {
      if (userAnswers[i] === correctAnswers[i]) score++;
    }

    const resultCard = document.getElementById('resultCard');
    const scoreText = document.getElementById('scoreText');
    const evalText = document.getElementById('evalText');

    scoreText.innerText = `${score} / 5`;
    
    if (score === 5) evalText.innerText = "Gokil bgt! Megy berhasil taklukin TKA SMA dengan skor sempurna! 🏆🔥";
    else if (score >= 3) evalText.innerText = "Mantap! Penguasaan materi TKA-nya makin kuat dan siap tempur! 💪";
    else evalText.innerText = "Tetap semangat! Pelajari jawabannya, besok kita hajar lagi di Day 6! 🚀";

    resultCard.style.display = 'block';
    resultCard.scrollIntoView({ behavior: 'smooth' });
  }
</script>

</body>
</html>
  
